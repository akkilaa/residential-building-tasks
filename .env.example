# ── Telegram ──────────────────────────────────────────────────────────────────
# Bot token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ1234567890abc

# ID of the Telegram group the bot should post to
# To find it: add @userinfobot to the group, it will reply with the chat ID
GROUP_CHAT_ID=-1001234567890

# Telegram user ID of the admin (allowed to use /remind)
# To find yours: message @userinfobot directly
ADMIN_USER_ID=123456789

# ── State ─────────────────────────────────────────────────────────────────────
STATE_FILE=bot_state.json

# ── Language ──────────────────────────────────────────────────────────────────
# Available: sr (Serbian), en (English)
LOCALE=sr

# ── Scheduler ─────────────────────────────────────────────────────────────────
# How often the scheduler checks for overdue tasks, in seconds
SCHEDULER_CHECK_INTERVAL=3600

# How many hours to wait before re-sending an unacknowledged reminder
NOTIFICATION_RESEND_INTERVAL_HOURS=24
